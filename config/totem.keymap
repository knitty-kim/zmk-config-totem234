#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q  &kp W  &kp E         &kp R  &kp T    &kp Y      &kp U           &kp I         &kp O    &kp P
           &kp A  &kp S  &kp D         &kp F  &kp G    &kp H      &kp J           &kp K         &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C         &kp V  &kp B    &kp N      &kp M           &kp COMMA     &kp DOT  &kp FSLH  &kp APOS
                         &kp LEFT_GUI  &mo 2  &mo 1    &kp SPACE  &kp LEFT_SHIFT  &kp LEFT_ALT
            >;
        };

        nav_num {
            bindings = <
                  &kp ESC      &kp BACKSPACE  &kp UP     &kp DELETE  &kp GRAVE        &kp EQUAL  &kp N7          &kp N8        &kp N9  &kp PERIOD
                  &kp TAB      &kp LEFT       &kp DOWN   &kp RIGHT   &kp BACKSLASH    &kp MINUS  &kp N4          &kp N5        &kp N6  &kp ASTERISK
&kp LEFT_CONTROL  &kp PAGE_UP  &kp HOME       &kp ENTER  &kp END     &kp PAGE_DOWN    &kp N0     &kp N1          &kp N2        &kp N3  &kp SLASH     &kp LEFT_CONTROL
                                              &trans     &trans      &trans           &kp SPACE  &kp LEFT_SHIFT  &kp LEFT_ALT
            >;
        };

        sym_func {
            bindings = <
                  &kp ESC        &kp LEFT_BRACE        &none       &kp RIGHT_BRACE        &kp LEFT_CONTROL    &kp CAPS        &kp F7          &kp F8        &kp F9  &kp F12
                  &kp TAB        &kp LBKT              &kp LSHIFT  &kp RBKT               &kp LEFT_ALT        &kp LANGUAGE_1  &kp F4          &kp F5        &kp F6  &kp F11
&kp LEFT_CONTROL  &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp ENTER   &kp RIGHT_PARENTHESIS  &kp GREATER_THAN    &kp LANGUAGE_2  &kp F1          &kp F2        &kp F3  &kp F10  &none
                                                       &trans      &trans                 &trans              &kp SPACE       &kp LEFT_SHIFT  &kp LEFT_ALT
            >;
        };

        device {
            bindings = <
       &none        &kp LA(BACKSPACE)   &kp LG(UP_ARROW)    &kp LA(DELETE)       &none     &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp LG(TAB)  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &none     &kp C_BRI_UP  &kp C_VOL_UP    &none         &none         &none
&none  &none        &none               &none               &none                &none     &kp C_BRI_DN  &kp C_VOL_DN    &none         &none         &none         &bt BT_CLR
                                        &trans              &trans               &trans    &none         &kp LEFT_SHIFT  &kp LEFT_ALT
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
